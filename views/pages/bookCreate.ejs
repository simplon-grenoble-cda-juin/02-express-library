<%- include("../partials/head", { title: "Liste des livres" }) %>

<main>
  <h1>Ajout d'un livre</h1>

  <form action="/books" method="post" class="book-create-form">
    <label for="title" class="book-create-label">Titre du livre</label>

    <input
      id="title"
      type="text"
      name="title"
      class="book-create-input"
      value="<%= values?.title || '' %>"
    />

    <% if (errors?.title?.errors?.[0]) { %>
    <small id="title-error" style="color: #f44336">
      <%= errors.title.errors[0] %>
    </small>
    <% } %>

    <button type="submit" class="book-create-button">Enregistrer</button>
  </form>
</main>

<%- include("../partials/footer") %>
